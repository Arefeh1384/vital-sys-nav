  if(view.kind==='supply-case'){const c=cases.find(x=>x.id===view.id);if(!c)return <div dir="rtl">پرونده یافت نشد.</div>;const r=supplyRisks.find(x=>x.id===c.riskId)!;return <div dir="rtl" className="text-right">{head(c.item,`${c.id} · ${statusLabels[c.status]}`,()=>open({kind:'supply-cases'}))}<div className="mb-4 flex flex-wrap gap-2"><Button onClick={()=>open({kind:'supply-risk',id:r.id})}>مشاهده ریسک و شواهد</Button><Button onClick={()=>{setProposal(initProposal(r,'replenishment'));open({kind:'supply-new',riskId:r.id,type:'replenishment'})}}>ایجاد پیشنهاد تأمین</Button><Button variant="outline" onClick={()=>{setProposal(initProposal(r,'transfer'));open({kind:'supply-new',riskId:r.id,type:'transfer'})}}>ایجاد پیشنهاد انتقال</Button><Button variant="outline" onClick={()=>setTaskSource({supplyCaseId:c.id})}>ایجاد وظیفه پیگیری</Button><Button variant="outline" onClick={()=>open({kind:'manual-list'})}>پیگیری اقدامات دستی</Button></div><div className="grid gap-4 lg:grid-cols-2"><Card><CardHeader><CardTitle>نمای کلی پرونده</CardTitle></CardHeader><CardContent className="space-y-2 text-sm"><p>مالک: {c.owner}</p><p>موجودی قابل برنامه‌ریزی: {r.usable} واحد</p><p>مرجع پیش‌بینی: <bdi>{r.forecastRef}</bdi></p><p>پیشنهادهای مرتبط: {proposals.filter(p=>p.caseId===c.id).length}</p><p>وضعیت پیگیری مستقل از وضعیت پیشنهاد: {statusLabels[c.status]}</p><label className="block pt-2">وضعیت پرونده<select className="mt-1 w-full rounded-md border p-2" value={c.status} onChange={e=>{const next={...c,status:e.target.value as typeof c.status,activity:[...c.activity,{at:new Date().toISOString(),text:`وضعیت پرونده به ${statusLabels[e.target.value as typeof c.status]} تغییر کرد`}]};saveCase(next);notify('وضعیت نمایشی پرونده تغییر کرد.');open({kind:'supply-case',id:c.id})}}>{Object.entries(statusLabels).map(([k,v])=><option value={k} key={k}>{v}</option>)}</select></label></CardContent></Card><Card><CardHeader><CardTitle>پیشنهادهای مرتبط</CardTitle></CardHeader><CardContent><ProposalTable proposals={proposals.filter(p=>p.caseId===c.id)} open={open}/></CardContent></Card><Card><CardHeader><CardTitle>وضعیت اقدام (فقط خواندنی)</CardTitle></CardHeader><CardContent>{c.actionState==='uncertain'?<p className="rounded-lg bg-amber-50 p-3 text-sm text-amber-900">نتیجه اجرا نامشخص است؛ این وضعیت نه موفقیت است و نه شکست.</p>:<p className="text-sm text-slate-500">اقدام منبعی ثبت نشده است. ذخیره پیش‌نویس، تأیید یا اجرای سفارش محسوب نمی‌شود.</p>}<p className="mt-3 text-sm">{c.outcome}</p></CardContent></Card><Card><CardHeader><CardTitle>خط زمانی فعالیت</CardTitle></CardHeader><CardContent className="space-y-3">{c.activity.map((a,i)=><div className="border-r-2 border-teal-200 pr-3" key={i}><p className="text-sm font-bold">{a.text}</p><p className="text-xs text-slate-500">{a.at}</p></div>)}</CardContent></Card></div><TaskDrawer source={taskSource} defaults={{title:`پیگیری کمبود ${c.item}`,description:`ارجاع به پرونده ${c.id} و ریسک ${r.id}. بررسی شواهد تأمین و ثبت نتیجه.`}} close={()=>setTaskSource(null)} created={t=>{setTaskSource(null);notify('وظیفه پیگیری نمایشی ایجاد شد؛ پرونده مرجع: '+c.id);open({kind:'task',id:t.id})}}/></div>}
